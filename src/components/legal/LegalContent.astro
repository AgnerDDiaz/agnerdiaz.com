---
import type { Lang } from "@i18n/ui";
import {
  buildLegalDoc,
  DOC_LABEL,
  UPDATED_LABEL,
  CONTACT_LABEL,
  type LegalApp,
  type LegalDoc,
} from "@data/legal";

interface Props {
  app: LegalApp;
  doc: LegalDoc;
  lang: Lang;
  backHref: string;
  backLabel: string;
}
const { app, doc, lang, backHref, backLabel } = Astro.props;

const docTitle = DOC_LABEL[doc][lang];
const sections = buildLegalDoc(app, doc, lang);
const updatedFmt = new Intl.DateTimeFormat(lang === "es" ? "es-DO" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(new Date(`${app.updated}T12:00:00`));
---
<div class="container legal">
  <a class="section__eyebrow" href={backHref}>← {backLabel}</a>
  <h1 class="legal__title">{docTitle}</h1>
  <p class="legal__meta"><strong>{app.name}</strong> · {UPDATED_LABEL[lang]}: {updatedFmt}</p>

  {
    sections.map((s) => (
      <section class="legal__section">
        <h2>{s.heading}</h2>
        {s.paragraphs.map((p) => <p>{p}</p>)}
      </section>
    ))
  }

  <section class="legal__section">
    <h2>{CONTACT_LABEL[lang]}</h2>
    <p><a class="legal__mail" href={`mailto:${app.supportEmail}`}>{app.supportEmail}</a></p>
  </section>
</div>

<style>
  .legal { max-width: 760px; }
  .legal__title { margin: 12px 0 6px; font-size: clamp(28px, 4vw, 40px); font-weight: 900; letter-spacing: 0.4px; }
  .legal__meta { margin: 0 0 8px; color: var(--muted); }
  .legal__section { margin-top: 26px; }
  .legal__section h2 {
    font-size: 15px; font-weight: 900; letter-spacing: 1px; text-transform: uppercase;
    margin: 0 0 10px; padding-bottom: 8px; position: relative;
  }
  .legal__section h2::after { content: ""; position: absolute; left: 0; bottom: 0; width: 40px; height: 3px; border-radius: 99px; background: var(--accent); }
  .legal__section p { line-height: var(--lh-prose); color: color-mix(in srgb, var(--text) 88%, var(--muted)); margin: 0 0 10px; }
  .legal__mail { color: var(--accent); font-weight: 800; }
</style>
