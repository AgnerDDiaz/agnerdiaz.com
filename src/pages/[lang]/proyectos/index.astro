---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/nav/Header.astro";
import Footer from "@components/nav/Footer.astro";
import ProjectCard from "@components/projects/ProjectCard.astro";
import { site } from "@data/site";
import { useTranslations, toLang } from "@i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const kinds = ["mobile", "web", "tool"] as const;
const present = kinds.filter((k) => projects.some((p) => p.data.kind === k));

const title = lang === "es" ? "Proyectos | Agner Díaz" : "Projects | Agner Díaz";
---

<BaseLayout lang={lang} title={title} description={t("projects.pageSubtitle")} path="/proyectos/">
  <a class="skip-link" href="#main">{t("a11y.skip")}</a>
  <Header lang={lang} path="/proyectos/" onHome={false} />

  <main id="main">
    <section class="section">
      <div class="container">
        <div class="section__head">
          <a class="section__eyebrow" href={`/${lang}/#projects`}>← {t("projects.back")}</a>
          <h2>{t("projects.title")}</h2>
          <p class="section__sub">{t("projects.pageSubtitle")}</p>
        </div>

        <div class="filters" id="projectFilters" role="group" aria-label={t("projects.title")}>
          <button class="filter-btn" type="button" data-filter="all" aria-pressed="true">{t("projects.filter.all")}</button>
          {present.map((k) => (
            <button class="filter-btn" type="button" data-filter={k} aria-pressed="false">{t(`projects.filter.${k}` as any)}</button>
          ))}
        </div>

        <div class="projects-grid" id="projectsGrid">
          {projects.map((proj) => <ProjectCard project={proj} lang={lang} />)}
        </div>

        <div class="section-cta" style="margin-top:26px">
          <a class="btn btn--soft" href={site.socials.github} target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.833.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.27.098-2.646 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.376.202 2.394.1 2.647.64.7 1.028 1.595 1.028 2.688 0 3.848-2.338 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.523 2 12 2z"/></svg>
            {t("projects.githubMore")}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  const filters = document.getElementById("projectFilters");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("#projectsGrid .project"));
  filters?.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const kind = btn.getAttribute("data-filter");
      filters.querySelectorAll(".filter-btn").forEach((b) =>
        b.setAttribute("aria-pressed", b === btn ? "true" : "false"),
      );
      cards.forEach((card) => {
        const show = kind === "all" || card.getAttribute("data-kind") === kind;
        card.classList.toggle("is-hidden", !show);
      });
    });
  });
</script>
