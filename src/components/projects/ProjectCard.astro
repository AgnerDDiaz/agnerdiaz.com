---
import type { CollectionEntry } from "astro:content";
import TechChips from "@components/ui/TechChips.astro";
import { useTranslations, type Lang, type UIKey } from "@i18n/ui";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
}
const { project, lang } = Astro.props;
const t = useTranslations(lang);
const d = project.data;
const href = `/${lang}/proyectos/${project.id}/`;
---
<a
  class="card project reveal"
  href={href}
  data-kind={d.kind}
  style={`--proj-accent:${d.accent ?? "var(--accent)"}`}
>
  <div class="project__topline">
    <h3 class="project__title">{d.title}</h3>
    <span class={`status status--${d.status}`}>{t(`projects.status.${d.status}` as UIKey)}</span>
  </div>
  <p class="project__role">{d.role[lang]}</p>
  <p class="project__tagline">{d.tagline[lang]}</p>
  {
    d.metrics.length > 0 && (
      <div class="project__metrics">
        {d.metrics.map((m) => (
          <div class="project__metric"><b>{m.value}</b><span>{m.label[lang]}</span></div>
        ))}
      </div>
    )
  }
  <TechChips ids={d.tech} />
  <span class="project__more">
    {t("projects.details")}
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </span>
</a>
