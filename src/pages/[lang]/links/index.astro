---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/nav/Header.astro";
import Footer from "@components/nav/Footer.astro";
import { site } from "@data/site";
import { links } from "@data/links";
import { useTranslations, toLang } from "@i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const roles = JSON.stringify(site.roles[lang]);
const title = lang === "es" ? "Links | Agner Díaz" : "Links | Agner Díaz";
---

<BaseLayout lang={lang} title={title} description={t("links.subtitle")} path="/links/">
  <a class="skip-link" href="#main">{t("a11y.skip")}</a>
  <Header lang={lang} path="/links/" onHome={false} minimal />

  <main id="main">
    <section class="section links-page">
      <div class="container">
        <div class="card links-card">
          <div class="links-hero">
            <div class="avatar links-avatar">
              <img src="/assets/img/profile.jpg" alt={site.name} width="220" height="220" />
            </div>
            <div class="links-heroText">
              <p class="links-kicker">{t("links.kicker")}</p>
              <h1 class="links-name">
                <span>{site.brand.first.toUpperCase()}</span> <span class="accent">{site.brand.last.toUpperCase()}</span>
              </h1>
              <p class="hero__roles links-role" data-roles={roles}>
                <span class="typing" aria-hidden="true"></span><span class="typing__cursor" aria-hidden="true"></span>
                <span class="sr-only">{t("hero.availabilityRole")}</span>
              </p>
              <p class="muted links-sub">{t("links.subtitle")}</p>
            </div>
          </div>

          <div class="links-actions">
            {
              links.map((item) => (
                <a
                  class={`btn ${item.primary ? "btn--primary" : "btn--soft"} links-btn`}
                  href={item.href(lang)}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noreferrer" : undefined}
                >
                  {item.icon === "linkedin" ? (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.5 8.2h4V24h-4V8.2zM8.2 8.2H12v2.2h.1c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.78 2.65 4.78 6.1V24h-4v-7.5c0-1.8-.03-4.1-2.5-4.1-2.5 0-2.88 1.95-2.88 4V24h-4V8.2z"/></svg>
                  ) : item.icon === "github" ? (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.833.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.27.098-2.646 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.376.202 2.394.1 2.647.64.7 1.028 1.595 1.028 2.688 0 3.848-2.338 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.523 2 12 2z"/></svg>
                  ) : (
                    <span aria-hidden="true">{item.icon}</span>
                  )}
                  <span>{item.label[lang]}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .links-page { display: flex; align-items: center; min-height: calc(100vh - var(--nav-h) - 160px); }
  .links-card { max-width: 560px; margin: 0 auto; width: 100%; padding: 28px; }
  .links-hero { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; }
  .links-avatar { width: 150px; aspect-ratio: 1/1; margin-bottom: 6px; }
  .links-kicker { margin: 0; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--accent); font-size: 13px; }
  .links-name { margin: 2px 0 4px; font-size: clamp(34px, 8vw, 48px); font-weight: 900; letter-spacing: 0.5px; line-height: 1; }
  .links-name .accent { color: var(--accent); }
  .links-role { margin: 0; min-height: 1.2em; font-size: clamp(14px, 3vw, 18px); }
  .links-role .typing { min-width: 18ch; }
  .links-sub { margin: 8px 0 0; max-width: 40ch; }
  .links-actions { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
  .links-btn { width: 100%; height: 52px; justify-content: center; font-size: 14px; }
  .links-btn svg { width: 18px; height: 18px; fill: currentColor; }
</style>
